{
	# Kontakt fuer Let's Encrypt: bekommt Warnung, wenn eine
	# Zertifikatserneuerung scheitert.
	email info@verinaris.de
}

demo.verinaris.de {
	# Streamlit braucht WebSockets -- Caddy leitet die automatisch durch.
	reverse_proxy frontend:8501

	encode gzip

	log {
		output stdout
		format console
	}
}

kontakt.verinaris.de {
	request_body {
		max_size 20KB
	}
	reverse_proxy kontakt:8000
	encode gzip
}
